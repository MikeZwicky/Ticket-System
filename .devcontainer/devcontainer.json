{
  "name": "Java",
  "image": "mcr.microsoft.com/devcontainers/java:0-17",

  "features": {
    "ghcr.io/devcontainers/features/java": {
      "javaVersion": "17.0.10-ms",
      "jdkDistro": "ms",
      "installMaven": true,
      "mavenVersion": "3.9.8",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "lts"
    }
  },

  "forwardPorts": [8080, 5173], // Add 5173 for SvelteKit dev server

  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "vmware.vscode-spring-boot",
        "github.copilot"
      ]
    }
  },

  "postStartCommand": "code . && sleep 2 && echo '🟢 Ready: Run tasks via Ctrl+Shift+P → Tasks: Run Task'"
}
